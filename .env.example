# Copie para .env e preencha. O .env é ignorado pelo git.

# Necessário apenas para a etapa de geração — a indexação roda sem chave.
ANTHROPIC_API_KEY=

# Índice vetorial
CJ_QDRANT_URL=http://localhost:6333
CJ_COLECAO=dispositivos

# Caminhos (relativos à raiz do projeto)
CJ_DIR_DADOS=data
CJ_CAMINHO_SQLITE=data/db/corpus.sqlite3
CJ_DIR_CACHE_LLM=.cache/llm

# Modelos locais
CJ_MODELO_DENSO=BAAI/bge-m3
CJ_MODELO_ESPARSO=Qdrant/bm25
CJ_MODELO_RERANK=BAAI/bge-reranker-v2-m3

# Chunking: dispositivo (fino, com expansao) | artigo (autocontido)
CJ_ESTRATEGIA_CHUNK=dispositivo

# Recuperacao: ate onde a expansao sobe — artigo | nenhum | secao
CJ_NIVEL_EXPANSAO=artigo
# O rerank custa ~11 s por consulta na CPU; false para geracao rapida
CJ_USAR_RERANK=true

# Geração: api (citations nativas, pede ANTHROPIC_API_KEY) | ollama (local, sem custo)
#          | cli (claude -p pela assinatura)
CJ_MODELO_LLM=claude-opus-5
CJ_BACKEND_LLM=api

# Geração local — só vale com CJ_BACKEND_LLM=ollama. `docker compose up -d ollama`
# e `docker compose exec ollama ollama pull qwen3.5:4b` antes.
CJ_OLLAMA_URL=http://localhost:11434
CJ_MODELO_LOCAL=qwen3.5:4b
CJ_OLLAMA_NUM_CTX=16384
CJ_OLLAMA_KEEP_ALIVE=30m
# true: ~60 s por resposta e correta. false: ~2 s, mas errou a pergunta retroativa do golden
CJ_OLLAMA_PENSAR=true
